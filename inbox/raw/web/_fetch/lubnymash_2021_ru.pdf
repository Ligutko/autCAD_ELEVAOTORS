<style id="wp-custom-css">
.slide-menu .slick-slide {
border-left: 1px solid #292929;
}
.elementor-widget-text-editor ul, .elementor-widget-text-editor ol, .elementor-element.elementor-element-1abe0f3.elementor-widget.elementor-widget-ha-post-content.happy-addon.ha-post-content ul, .elementor-element.elementor-element-1abe0f3.elementor-widget.elementor-widget-ha-post-content.happy-addon.ha-post-content ol {
padding-left: 15px;
margin-bottom:20px;
}
.table-responsive {
overflow-x: auto;
-webkit-overflow-scrolling: touch;
}
body #powerTip {
background-color: #fff;
padding:35px;
box-shadow: 0px 0px 10px 0px rgba(0, 0, 0, 0.14);
}
body .box_view_html {
color: #000;
}
body .box_view_html p{
font-size: 14px;
line-height: 1.4em;
}
body .box_view_html h5{
font-size: 17px;
line-height: 1.4em;
}
.elementor-widget-text-editor ul, .elementor-widget-text-editor ol {
padding-left: 15px;
margin-bottom:20px;
}
.table-responsive {
overflow-x: auto;
-webkit-overflow-scrolling: touch;
}
body #powerTip {
background-color: #fff;
padding:35px;
box-shadow: 0px 0px 10px 0px rgba(0, 0, 0, 0.14);
}
body .box_view_html {
color: #000;
}
body .box_view_html p{
font-size: 14px;
line-height: 1.4em;
}
body .box_view_html h5{
font-size: 17px;
line-height: 1.4em;
}
.custom-details {
margin:15px 0;
}
.custom-details summary {
cursor:pointer;
display:inline-flex;
align-items:center;
gap:8px;
font-weight:600;
transition:0.25s ease;
user-select:none;
color: #e30613;
}
/* hover ефект */
.custom-details summary:hover{
color:#000;
opacity:0.85;
}
/* прибираємо стандартну стрілку */
.custom-details summary::-webkit-details-marker{
display:none;
}
/* власна стрілочка */
.custom-details summary::after{
content:'▾';
transition:transform 0.3s ease;
}
/* поворот стрілки */
.custom-details[open] summary::after{
transform:rotate(180deg);
}
/* плавне відкриття */
.details-content{
display:grid;
grid-template-rows:0fr;
transition:grid-template-rows 0.35s ease;
}
.details-content > *{
overflow:hidden;
}
.custom-details[open] .details-content{
grid-template-rows:1fr;
}
/* відступ тексту */
.custom-details .details-content{
margin-top:10px;
}
.mfp-wrap .mfp-arrow {
display: none;
}
span.wpcf7-list-item-label {
margin-bottom: 15px;
}
.wpcf7-form-control-wrap input[type="checkbox"] {
float: left;
margin: 2px 10px !important;
}
.elementor-widget-n-tabs > .e-n-tabs > .e-n-tabs-heading > .e-n-tab-title:focus {
border-top: 0!important;
border-left: 0!important;
border-right: 0!important;
}
.wpcf7-list-item {
margin: 10px 5px;
width: 100%;
}
</style>
</head>
